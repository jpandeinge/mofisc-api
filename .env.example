# =============================================================================
# MOFISC API - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit .env to version control (already in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=false
PORT=8000
UVICORN_EXTRA_ARGS=--reload  # Remove in production

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# Generate strong secrets for production using:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this
API_KEY_SECRET=your-api-key-secret-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Primary database connection string
DATABASE_URL=postgresql://mofisc:mofisc@localhost:5432/mofisc
DB_NAME=mofisc
DB_USER=mofisc
DB_PASSWORD=mofisc

# Database Pool Settings (adjust for production load)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=5

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Client-safe key: current sb_publishable_... format (legacy anon JWT also works)
SUPABASE_KEY=sb_publishable_replace-with-your-publishable-key
# Server only: current sb_secret_... format (legacy service_role JWT also works)
# Never reuse SUPABASE_KEY here.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace-with-your-service-role-key
SUPABASE_TABLE_NAME=transactions
SUPABASE_CONNECT_TIMEOUT=3
SUPABASE_READ_TIMEOUT=5

# -----------------------------------------------------------------------------
# TRANSACTION CLASSIFICATION
# -----------------------------------------------------------------------------
# The public repository does not include the trained production model. Use
# "local" only when a trusted compatible artifact is supplied separately;
# "hf_endpoint" uses an operator-managed endpoint and "auto" tries both.
TRANSACTION_MODEL_BACKEND=local
PFC_MODEL_REQUIRED=0

# Conservative open-world merchant gate. Higher values leave more unknown
# merchants blank instead of force-linking them to the wrong canonical name.
LOCAL_MODEL_ENABLED=0
# Set to 1 only in a controlled deployment that supplies the private artifact.
LOCAL_MODEL_REQUIRED=0
# Controlled deployments can point this at an injected private artifact.
# LOCAL_MODEL_DIR=api/app/resources/models/pfc_v4
LOCAL_MODEL_MERCHANT_THRESHOLD=0.65
LOCAL_MODEL_MERCHANT_MARGIN=0.20

# Private custom endpoint created from deploy/huggingface/pfc_v4.
# Set both only when TRANSACTION_MODEL_BACKEND=hf_endpoint or auto.
# HF_PFC_ENDPOINT_URL=https://your-endpoint.endpoints.huggingface.cloud
# HF_PFC_TOKEN=your_read_token

# Legacy label-only endpoint. Development fallback only.
# HF_ENDPOINT_URL=https://your-legacy-endpoint.endpoints.huggingface.cloud
# HF_TOKEN=your_legacy_read_token

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION
# -----------------------------------------------------------------------------
# Optional: only needed for browser/mobile push while the app is closed.
# Live in-app notifications use Supabase Realtime and work without Firebase.
# FIREBASE_CREDENTIALS_BASE64=your-base64-credentials

# Firebase Web API Key (for client-side Firebase operations)
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SendGrid) - OPTIONAL
# Leave empty or remove to disable email notifications
# -----------------------------------------------------------------------------
# SENDGRID_API_KEY=your-sendgrid-api-key
# FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Mofisc
SENDGRID_TIMEOUT=30
SENDGRID_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# SMS CONFIGURATION (Twilio via Firebase Cloud Functions)
# -----------------------------------------------------------------------------
# Option 1: Firebase Cloud Function URL
FIREBASE_SMS_CLOUD_FUNCTION_URL=https://your-region-your-project.cloudfunctions.net/sendSMS
# Set the same random secret (32+ characters) in Firebase Secret Manager and
# the API environment. Never use the public Firebase web API key here.
# SMS_API_SECRET=

# Option 2: Direct Twilio integration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
SMS_TIMEOUT=30
SMS_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Caching & Rate Limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Optional, leave empty if no password
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_NOTIFICATIONS_PER_HOUR=100

# -----------------------------------------------------------------------------
# CIRCUIT BREAKER (Resilience Pattern)
# -----------------------------------------------------------------------------
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text

# -----------------------------------------------------------------------------
# MONITORING & ERROR TRACKING (Sentry)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions
SENTRY_PROFILES_SAMPLE_RATE=0.1
METRICS_TOKEN=your-metrics-scrape-token
PUBLIC_API_TOKEN=your-public-api-token

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# JSON arrays of allowed origins and hosts
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ALLOWED_HOSTS=["*"]  # Use specific domains in production
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# DODO PAYMENTS PROCESSING
# -----------------------------------------------------------------------------
DODO_PAYMENTS_TRIAL_DAYS=7 # but it can be changed to any day
# Get API key from: https://app.dodopayments.com/settings/api
DODO_PAYMENTS_API_KEY=your-dodo-payments-api-key

# Dodo Payments Webhook Secret (for verifying webhook signatures)
# Get from: https://app.dodopayments.com/settings/webhooks
DODO_PAYMENTS_WEBHOOK_SECRET=your-webhook-secret

# Base URL (use test for development, live for production)
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com

# Redirect URLs after checkout
DODO_PAYMENTS_SUCCESS_URL=http://localhost:3000/payment/success
DODO_PAYMENTS_CANCEL_URL=http://localhost:3000/pricing

# -----------------------------------------------------------------------------
# NOTIFICATION SETTINGS
# -----------------------------------------------------------------------------
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_RETRY_DELAY=1
NOTIFICATION_MAX_PAYLOAD_SIZE_KB=4

# -----------------------------------------------------------------------------
# HEALTH CHECK
# -----------------------------------------------------------------------------
HEALTH_CHECK_TIMEOUT=5
